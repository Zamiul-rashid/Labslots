# Copy to .env next to docker-compose.yml and fill in. .env is never committed.
# Passwords and keys do not go here: they are files under secrets/ (see the end of docker-compose.yml).

# Timezone the weekly slots are in (IANA name, e.g. Asia/Dhaka, Europe/London).
TZ=UTC

# How the site names the lab and the organisation ("your university Google account").
LABSLOTS_LAB_NAME=Research Lab
LABSLOTS_ORG_NAME=university

# Email domains students sign in and enroll with; the first one is the form's default.
LABSLOTS_STUDENT_DOMAINS=students.example.edu

# Image to run; deploy.sh updates this line.
LABSLOTS_IMAGE=ghcr.io/zamiul-rashid/labslots:latest

# Comma-separated admin emails that always exist (the Sheet's Admins tab adds more).
LABSLOTS_BOOTSTRAP_ADMINS=admin@example.edu

# ID of the Google Sheet that holds the schedule; empty = Sheet sync off.
LABSLOTS_SHEET=

# Outgoing email for enrollment decisions; off while SMTP_HOST or SMTP_FROM is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
